rules_version = '2';

// Each signed-in user can read and write only their own data: users/{uid}/sections/{section}.
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sections/{section} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && section in ['caregivers', 'clients', 'contacts', 'sheetDistances', 'meta']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
